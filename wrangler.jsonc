{
 "$schema":"node_modules/wrangler/config-schema.json",
 "name":"pi-private-chat",
 "main":"src/index.ts",
 "compatibility_date":"2026-10-11",
 "compatibility_flags":["nodejs_compat"],
 "workers_dev":false,
 "preview_urls":false,
 "assets":{"directory":"./public","binding":"ASSETS","run_worker_first":true},
 "durable_objects":{"bindings":[{"name":"Assistant","class_name":"Assistant"}]},
 "migrations":[{"tag":"v1","new_sqlite_classes":["Assistant"]}],
 "vars":{"ACCESS_TEAM_DOMAIN":"","ACCESS_AUD":"","OWNER_EMAILS":"","APP_ORIGIN":"","ENABLE_MODEL":"false","ENABLE_SUBSCRIPTION_LOGIN":"false","ENABLE_WEB_SEARCH":"false","ENABLE_WEB_SEARCH_TEST":"false"},
 "observability":{"logs":{"enabled":true,"head_sampling_rate":1,"invocation_logs":true,"persist":true},"traces":{"enabled":false,"head_sampling_rate":1,"persist":true},"issues":{"enabled":false}}
}
