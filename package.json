    "agents": "0.28.0",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261011.1",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "marked": "18.1.0",
    "miniflare": "5.20261006.1-alpha",
    "playwright-core": "1.64.0",
